    "features": {
      "eyebrow": "Features",
      "title": "Everything a school runs, in one place.",
      "body": "No more paper registers, spreadsheets or handwritten receipts. Every module talks to the others.",
      "items": {
        "attendance": {
          "title": "Registers in thirty seconds",
          "body": "Present, absent, late, excused: one tap per student, on the web or on a phone. Absences reach the office instantly."
        },
        "grades": {
          "title": "Marks out of 20",
          "body": "Configurable scales and coefficients, subject averages, report cards ready to print."
        },
        "finance": {
          "title": "Fees & receipts",
          "body": "Monthly or annual invoices, allocated payments, numbered receipts, traceable voids."
        },
        "schedule": {
          "title": "Timetables",
          "body": "Periods, rooms and teachers: everyone sees their week, and changes reach everyone at once."
        },
        "messages": {
          "title": "Announcements & messages",
          "body": "Broadcast to a class or the whole school, message students directly, and see who has read what."
        },
        "documents": {
          "title": "Documents",
          "body": "Certificates, report cards and paperwork, filed per student and shared securely."
        }
      },
