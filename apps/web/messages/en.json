    "security": {
      "eyebrow": "Security",
      "title": "Your school’s data stays yours.",
      "body": "Separation between schools is enforced by the database itself, not just the interface.",
      "items": {
        "isolation": {
          "title": "Strict isolation",
          "body": "Every query is filtered per school at the database level: one school never sees another’s data."
        },
        "roles": {
          "title": "Role-based access",
          "body": "Teachers and students only see their own classes and their own data."
        },
        "audit": {
          "title": "Audit log",
          "body": "Voided payments, sensitive edits: every important action is recorded."
        }
