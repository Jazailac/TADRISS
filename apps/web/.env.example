# Copy to .env.local. `pnpm dev:setup` prints local values (supabase status).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: enables the public /demo page (one-click sign-in as the seeded Al Manar accounts).
# Only set it on a throwaway demo deployment whose seeded accounts use this password.
DEMO_PASSWORD=
